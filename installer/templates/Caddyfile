{
 admin off
 persist_config off
 order forward_proxy before file_server
 log {
  output discard
 }
 log certificate_errors {
  level ERROR
  include tls.obtain tls.issuance.acme tls.issuance.zerossl
  output stderr
 }
 servers {
  protocols h1 h2
 }
}
:443, ${domain} {
 route {
  forward_proxy {
   import ${base}/auth.caddy
   hide_ip
   hide_via
   probe_resistance
   upstream http://127.0.0.1:1081
  }
  file_server {
   root ${base}/site-current
   pass_thru
  }
  file_server {
   root ${base}/site
  }
 }
}
