[Unit]
Description=Empire HTTPS website and Naive padding
BindsTo=${prefix}-network.service
PartOf=${prefix}-network.service
Requires=${prefix}-singbox.service
After=${prefix}-network.service ${prefix}-singbox.service
[Service]
Type=notify
User=evpn
Group=evpn
NetworkNamespacePath=/run/netns/naive
BindReadOnlyPaths=/etc/netns/naive/resolv.conf:/etc/resolv.conf
ExecStart=/opt/empire-vpn/bin/caddy run --config ${base}/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
StateDirectory=empire-vpn-acme
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/empire-vpn-acme
Environment=XDG_CONFIG_HOME=/var/lib/empire-vpn-acme
Environment=GOMEMLIMIT=256MiB
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target ${prefix}-network.service
